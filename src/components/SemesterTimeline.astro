---
import { getPublishedCollection } from "astro-course-university/content";
import { buildSemesterTimeline, weekBoundaryFor } from "../lib/semester-timeline";
import { sessionLabels } from "../site-config";

const BREAK_AFTER_WEEK = 6;
const BREAK_WEEKS = 2;
// Not published in any content collection --- these are the two enrolment
// deadlines every ANU-style semester carries, invented for this fictional
// course but consistent with its real calendar: census before the first
// pin-up (Week 4), last day to drop before the second (Week 9).
const CENSUS_DATE = "2027-03-12";
const DROP_BY_DATE = "2027-04-30";

const [lectures, studios, assessments] = await Promise.all([
  getPublishedCollection("lectures"),
  getPublishedCollection("sessions"),
  getPublishedCollection("assessments"),
]);

const weekDates = lectures.map((lecture) => ({ week: lecture.data.week, date: lecture.data.date }));

const cells = buildSemesterTimeline({
  totalWeeks: lectures.length,
  breakAfterWeek: BREAK_AFTER_WEEK,
  breakWeeks: BREAK_WEEKS,
  lectureWeeks: lectures.map((lecture) => lecture.data.week),
  studioWeeks: studios.map((studio) => studio.data.week),
  assessments: assessments.map((assessment) => ({
    week: assessment.data.week,
    weight: assessment.data.weight,
  })),
  markers: [
    { label: "census date", afterWeek: weekBoundaryFor(CENSUS_DATE, weekDates) },
    { label: "last day to drop", afterWeek: weekBoundaryFor(DROP_BY_DATE, weekDates) },
  ],
});
---

<div class="semester-timeline">
  <div class="semester-timeline-track">
    {
      cells.map((cell) => {
        if (cell.kind === "marker") {
          return (
            <div class="st-marker" role="presentation">
              <span class="st-marker-label">{cell.label}</span>
            </div>
          );
        }
        if (cell.kind === "break") {
          return (
            <div class="st-cell st-cell--break">
              <span class="st-week-label">break</span>
            </div>
          );
        }
        return (
          <div class="st-cell">
            <span class="st-assessment-slot">
              {cell.assessment && (
                <>
                  <span class="st-dot st-dot--assessment" aria-hidden="true" />
                  <span class="st-assessment-label">
                    <span>{cell.assessment.shortLabel}</span>
                    <span aria-hidden="true">·</span>
                    <span>{cell.assessment.weight}%</span>
                  </span>
                </>
              )}
            </span>
            <span class="st-dot st-dot--studio" aria-hidden="true" />
            <span class="st-dot st-dot--lecture" aria-hidden="true" />
            <span class="st-week-label">{cell.week}</span>
          </div>
        );
      })
    }
  </div>

  <ul class="st-legend">
    <li><span class="st-dot st-dot--assessment" aria-hidden="true" /> Assignments</li>
    <li><span class="st-dot st-dot--studio" aria-hidden="true" /> {sessionLabels.plural}</li>
    <li><span class="st-dot st-dot--lecture" aria-hidden="true" /> Lectures</li>
    <li><span class="st-tick" aria-hidden="true" /> Enrolment dates</li>
  </ul>
</div>

<style>
  .semester-timeline {
    margin-block: 2.5rem 2rem;
  }

  .semester-timeline-track {
    display: flex;
    align-items: stretch;
    position: relative;
    block-size: 13rem;
    border-block: 1px solid var(--at-divider);
    border-inline-start: 1px solid var(--at-divider);
  }

  .st-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    flex: 1 1 0;
    min-width: 0;
    padding-block: 0 0.5rem;
    border-inline-end: 1px solid var(--at-divider);
  }

  .st-cell--break {
    flex: 2 1 0;
    background: color-mix(in srgb, var(--at-text-muted) 6%, transparent);
    color: var(--at-text-muted);
    font-size: var(--at-font-size-sm);
  }

  .st-assessment-slot {
    position: absolute;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .st-assessment-label {
    display: flex;
    gap: 0.3em;
    align-items: center;
    line-height: 1.15;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
    font-family: var(--at-font-mono);
    white-space: nowrap;
  }

  .st-dot {
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .st-dot--assessment {
    background: var(--at-primary);
  }

  .st-assessment-slot > .st-dot--assessment {
    inline-size: 1.1rem;
    block-size: 1.1rem;
  }

  .st-cell > .st-dot--studio {
    position: absolute;
    top: 6.1rem;
  }

  .st-cell > .st-dot--lecture {
    position: absolute;
    top: 9.2rem;
  }

  .st-dot--studio {
    background: var(--at-info);
  }

  .st-dot--lecture {
    background: var(--at-tertiary);
  }

  .st-week-label {
    font-size: var(--at-font-size-xs);
    color: var(--at-text-muted);
    font-family: var(--at-font-mono);
  }

  .st-marker {
    position: relative;
    flex: 0 0 0;
    z-index: 1;
  }

  .st-marker::after {
    content: "";
    position: absolute;
    inset-block: 0 2.8rem;
    border-inline-start: 1px dashed var(--at-text-muted);
  }

  .st-marker-label {
    position: absolute;
    bottom: calc(100% + 0.2rem);
    left: 0;
    transform: translateX(-50%);
    font-size: var(--at-font-size-xs);
    color: var(--at-text-muted);
    white-space: nowrap;
    font-family: var(--at-font-mono);
  }

  .st-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-block: 0.75rem 0;
    padding: 0;
    list-style: none;
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
  }

  .st-legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .st-tick {
    inline-size: 1px;
    block-size: 0.85rem;
    border-inline-start: 1px dashed var(--at-text-muted);
  }

  @media (max-width: 480px) {
    .st-assessment-label,
    .st-week-label,
    .st-marker-label {
      font-size: 0.65rem;
    }

    .st-cell:last-child .st-assessment-slot {
      right: 0.2rem;
      align-items: flex-end;
    }

    .st-cell:last-child .st-assessment-slot > .st-dot {
      margin-inline-end: 0.05rem;
    }

    .st-legend {
      gap: 0.4rem 0.9rem;
      font-size: 0.75rem;
    }
  }
</style>
