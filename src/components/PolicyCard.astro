---
export interface Props {
  /** Anchor id for the section --- must match the ids other pages deep-link to
   *  (e.g. `/policies/#extensions`), since this component sets it by hand
   *  rather than relying on heading-slug generation. */
  id: string;
  title: string;
  /** Span the full grid row instead of one column, for content (e.g. a table)
   *  that doesn't suit a narrow card. */
  wide?: boolean;
}

const { id, title, wide = false } = Astro.props;
---

<div class:list={["at-card", "policy-card", { "policy-card--wide": wide }]}>
  <div class="at-card-body">
    <h2 id={id} class="at-card-title">
      {title}
      <a href={`#${id}`} class="at-heading-anchor" aria-hidden="true" tabindex="-1">#</a>
    </h2>
    <slot />
  </div>
</div>

<style>
  /* These cards hold policy prose of very different lengths, not the theme's
     short, near-uniform nav blurbs --- override the grid's row-pairing
     subgrid so a short card doesn't stretch to match a long neighbour and
     leave dead space. */
  .policy-card {
    grid-row: auto;
    grid-template-rows: auto;
    /* CSS Grid stretches items to their row's height by default even without
       subgrid, so a short card would still pad out to match a tall neighbour
       in the same row --- opt this card out of that stretch. */
    align-self: start;
  }

  .policy-card--wide {
    grid-column: 1 / -1;
  }
</style>
