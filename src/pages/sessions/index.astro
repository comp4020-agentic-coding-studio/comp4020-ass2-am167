---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
  heroImage="/src/assets/images/studios-hero.svg"
  heroImageAlt="A plan sheet pinned to a studio wall with a critic's rust arrow drawn across it, flanked by two more pinned sheets, and a card reading the same route before the week's decision and six weeks after it."
>
  <p>
    One Kerrow Basin district continues through all twelve Mondays. Bring the
    named save and evidence to each studio: decisions made in one room become
    the constraints, comparisons and jury questions in the next.
  </p>
  <SessionsGrid />
</ContentLayout>
