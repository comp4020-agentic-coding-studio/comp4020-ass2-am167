---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { roleLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Display labels come from src/site-config.ts, shared with the people grid.
const role = person.data.role;
const roleLabel = role && role in roleLabels ? roleLabels[role as keyof typeof roleLabels] : "";
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

{/*
  The hero band is the site-wide page header, so this page gets the same
  people illustration its index does --- not the portrait. A square portrait in
  a wide full-bleed band crops the face out entirely and leaves a strip of
  collar under a dark scrim, so it runs inline beside the details instead, at
  the size it was drawn for.
*/}
<ContentLayout
  title={person.data.title}
  description={description}
  {...siteConfig}
  heroImage="/src/assets/images/people-hero.svg"
  heroImageAlt="Five figures in silhouette around a long studio table with a plan sheet open between them, and a sixth seated apart at the far end where the visiting critic sits."
>
  <div class="person-head">
    {person.data.photo && (
      <Image class="person-photo" src={person.data.photo} alt={photoAlt} width={440} height={440} />
    )}
    <dl>
      {roleLabel && (
        <>
          <dt>Role</dt>
          <dd>{roleLabel}</dd>
        </>
      )}
      {person.data.affiliation && (
        <>
          <dt>Affiliation</dt>
          <dd>{person.data.affiliation}</dd>
        </>
      )}
      {person.data.email && (
        <>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
          </dd>
        </>
      )}
      {person.data.url && (
        <>
          <dt>Web</dt>
          <dd>
            <a href={person.data.url}>{person.data.url}</a>
          </dd>
        </>
      )}
      <dt>Contact</dt>
      <dd>{person.data.contact}</dd>
    </dl>
  </div>

  <Content />
</ContentLayout>

<style>
  .person-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    align-items: start;
    margin-block-end: 2rem;
  }

  .person-head :global(.person-photo) {
    flex: 0 0 auto;
    width: 220px;
    height: auto;
    border: 1px solid var(--at-border, rgb(0 0 0 / 0.12));
  }

  .person-head dl {
    flex: 1 1 18rem;
    margin: 0;
  }
</style>
